async function pasteRateInto(brand){
  const inp = document.querySelector(`.bench-price[data-brand="${brand}"]`);
  if(!inp) return;
  if(!navigator.clipboard || !navigator.clipboard.readText){
    toast('⚠ Is browser mein clipboard access nahi mila — price manually type karo');
    return;
  }
  try{
    const text = await navigator.clipboard.readText();
    // Strip any "MRP ₹xxx" segment first so we don't accidentally pick up the strike-through MRP
    // instead of the actual selling price when someone copies the whole price block.
    const cleaned = text.replace(/MRP[^\d]{0,10}[\d,]+(\.\d+)?/gi, '');
    // pull the first plausible price out of whatever remains (₹229, Rs 229, 229.00, "229" etc.)
    // requires at least 2 digits before the decimal, so small per-100g rates like "4.58" are skipped
    const match = cleaned.match(/(?:₹|rs\.?|inr)?\s*([\d]{2,5}(?:\.\d{1,2})?)/i);
    if(!match){
      toast('⚠ Clipboard mein koi price nahi mila — platform page par jaake price copy karo (Ctrl+C) phir yahan click karo');
      return;
    }
    const val = parseFloat(match[1]);
    inp.classList.remove('invalid');
    if(val < PRICE_MIN || val > PRICE_MAX){
      inp.value = val;
      inp.classList.add('invalid');
      toast(`⚠ Clipboard se ₹${val} mila lekin ye range se bahar hai — check karo`);
      return;
    }
    inp.value = val;
    toast(`✓ ₹${val} bhar diya (${brand})`);
  }catch(err){
    toast('⚠ Clipboard padhne ki permission nahi mili — browser mein allow karo ya manually type karo');
  }
}

function prefillExisting(){
  const benchRows = DB.benchmark.filter(r=>r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform);
  benchRows.forEach(r=>{
    const inp = document.querySelector(`.bench-price[data-brand="${r.brand}"]`);
    if(inp) inp.value = r.price;
  });
  const availRows = DB.availability.filter(r=>r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform);
  availRows.forEach(r=>{
    const seg = document.querySelector(`.seg[data-sku="${r.skuId}"]`);
    if(seg){
      const btn = seg.querySelector(`[data-s="${r.status}"]`);
      if(btn){ seg.querySelectorAll('button').forEach(b=>b.classList.remove('on','A','NA','NL')); btn.classList.add('on', r.status); }
    }
    const rem = document.querySelector(`[data-sku-remark="${r.skuId}"]`);
    if(rem) rem.value = r.remarks || "";
  });
}

function saveEntry(){
  const row = DB.pincodes.find(p=>p.pincode===entryState.pincode);
  const area = row ? row.area : "";
  const enteredBy = document.getElementById('entryBy').value || "Unknown";

  // ---- VALIDATE FIRST: reject obviously wrong input before touching saved data ----
  let rejectedCount = 0;
  const validBenchInputs = [];
  document.querySelectorAll('.bench-price').forEach(inp=>{
    inp.classList.remove('invalid');
    const raw = inp.value.trim();
    if(raw === '') return; // blank is fine, just not saved
    const val = parseFloat(raw);
    if(isNaN(val) || val < PRICE_MIN || val > PRICE_MAX){
      inp.classList.add('invalid');
      rejectedCount++;
    } else {
      validBenchInputs.push({brand: inp.dataset.brand, price: val});
    }
  });
  if(rejectedCount > 0){
    toast(`⚠ ${rejectedCount} price field(s) look wrong (₹${PRICE_MIN}–₹${PRICE_MAX} range chahiye) — un fields ko theek karo, baaki save nahi hua`);
    return; // do not save anything until the invalid field is fixed
  }

  const validAvailRows = [];
  document.querySelectorAll('#availabilityList .seg').forEach(seg=>{
    const on = seg.querySelector('button.on');
    if(on){
      const skuId = parseInt(seg.dataset.sku);
      const sku = DB.skus.find(s=>s.id===skuId);
      const remark = document.querySelector(`[data-sku-remark="${skuId}"]`).value || "";
      validAvailRows.push({skuId, item: sku.item, category: sku.category, status: on.dataset.s, remarks: remark});
    }
  });

  if(validBenchInputs.length === 0 && validAvailRows.length === 0){
    toast('⚠ Kuch bhara nahi gaya — khali entry save nahi hoti');
    return;
  }

  // remove existing rows for this exact key (upsert behaviour) — only now, after validation passed
  DB.benchmark = DB.benchmark.filter(r=>!(r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform));
  DB.availability = DB.availability.filter(r=>!(r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform));

  const nowTs = new Date().toISOString();
  const nowTime = nowISTTime12();
  validBenchInputs.forEach(b=>{
    DB.benchmark.push({id:uid(), date:entryState.date, pincode:entryState.pincode, area, platform:entryState.platform, brand:b.brand, price:b.price, enteredBy, ts: nowTs, time: nowTime});
  });
  validAvailRows.forEach(a=>{
    DB.availability.push({id:uid(), date:entryState.date, pincode:entryState.pincode, area, platform:entryState.platform, skuId:a.skuId, item:a.item, category:a.category, status:a.status, remarks:a.remarks, enteredBy, ts: nowTs, time: nowTime});
  });

  persist('benchmark'); persist('availability');
  syncToCloud('benchmark', entryState, DB.benchmark.filter(r=>r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform));
  syncToCloud('availability', entryState, DB.availability.filter(r=>r.date===entryState.date && r.pincode===entryState.pincode && r.platform===entryState.platform));

  toast(`Saved: ${validBenchInputs.length} benchmark + ${validAvailRows.length} availability rows`);
  renderRecent();
}

function renderRecent(){
  const keys = new Map();
  DB.benchmark.forEach(r=>{
    const k = r.date+'|'+r.pincode+'|'+r.platform;
    if(!keys.has(k)) keys.set(k, {date:r.date, pincode:r.pincode, platform:r.platform, bench:0, avail:0, by:r.enteredBy});
    keys.get(k).bench++;
  });
  DB.availability.forEach(r=>{
    const k = r.date+'|'+r.pincode+'|'+r.platform;
    if(!keys.has(k)) keys.set(k, {date:r.date, pincode:r.pincode, platform:r.platform, bench:0, avail:0, by:r.enteredBy});
    keys.get(k).avail++;
  });
  const rows = [...keys.values()].sort((a,b)=> (a.date < b.date ? 1 : -1)).slice(0, 15);
  document.querySelector('#recentTable tbody').innerHTML = rows.map(r=>
    `<tr><td>${fmtDate(r.date)}</td><td>${pincodeLabel(r.pincode)}</td><td>${r.platform}</td><td>${r.bench}</td><td>${r.avail}</td><td>${r.by||''}</td></tr>`
  ).join('') || `<tr><td colspan="6" class="small-muted">No entries yet</td></tr>`;
}

/* ===================== CLOUD SYNC (optional) ===================== */
function syncToCloud(type, ctx, rows){
  if(!DB.settings.apiUrl || rows.length===0) return;
  const payload = { type, date: ctx.date, pincode: ctx.pincode, area: (DB.pincodes.find(p=>p.pincode===ctx.pincode)||{}).area || "",
    platform: ctx.platform, enteredBy: document.getElementById('entryBy') ? document.getElementById('entryBy').value : "",
    rows: rows.map(r=> type==='benchmark' ? {brand:r.brand, price:r.price} : {skuId:r.skuId, item:r.item, status:r.status, remarks:r.remarks}) };
  fetch(DB.settings.apiUrl, {method:'POST', body: JSON.stringify(payload)}).catch(()=>{});
}

