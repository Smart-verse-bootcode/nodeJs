      BRANDS.forEach(brand=>{
        const cellsVals = platformsPresent.map(p=>{ const rec = rows.find(x=>x.brand===brand && x.platform===p); return rec?rec.price:null; });
        const valid = cellsVals.filter(v=>v!==null);
        const min = valid.length?Math.min(...valid):null, max = valid.length?Math.max(...valid):null;
        const nc = wsP.getCell(pr,1); nc.value = FULL_NAME[brand]; if(brand==='Ganesh') nc.font = GOLD_FONT;
        platformsPresent.forEach((p,i)=>{
          const cell = wsP.getCell(pr,2+i);
          const v = cellsVals[i];
          if(v!==null){
            cell.value = v;
            if(valid.length>1){ if(v===min) cell.fill=GREEN_FILL; else if(v===max) cell.fill=RED_FILL; }
          }
        });
        pr++;
      });
      pr++;
    });
    pr++;
  });
  wsP.getColumn(1).width=30;
  for(let i=0;i<EXPORT_PLATFORM_ORDER.length;i++) wsP.getColumn(2+i).width=14;

  const buf = await wb.xlsx.writeBuffer();
  downloadBlob(buf, `TrendMark_Benchmark_Report_${todayISO()}.xlsx`);
}

function downloadBlob(buf, filename){
  const blob = new Blob([buf], {type:'application/octet-stream'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=filename; a.click();
  URL.revokeObjectURL(url);
}

