<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trend-Mark — Competition Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<style>
:root{
  --paper:#F6F0E2; --paper-alt:#FBF7EC; --ink:#241A12; --ink-soft:#6B5842;
  --line:#DECBA3; --line-soft:#EADFC2;
  --gold:#B8842E; --gold-deep:#8C6423; --gold-bg:#F3E4C2;
  --green:#2E6B3E; --green-bg:#DCEEDD; --green-line:#9FC9A8;
  --amber:#9C6B0A; --amber-bg:#F5E5BE; --amber-line:#DDBD73;
  --red:#A33327; --red-bg:#F5DAD3; --red-line:#E0A895;
  --shadow:0 1px 3px rgba(36,26,18,.10), 0 1px 1px rgba(36,26,18,.06);
}
*{box-sizing:border-box;}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;font-size:14px;line-height:1.45;}
.mono{font-family:'IBM Plex Mono',monospace;}
h1,h2,h3,.display{font-family:'Fraunces',serif;}
.app{max-width:1320px;margin:0 auto;padding:0 22px 60px;}
/* HEADER */
@keyframes auroraMove{0%{background-position:0% 50%;}50%{background-position:100% 50%;}100%{background-position:0% 50%;}}
header.top{position:relative;overflow:hidden;background:linear-gradient(120deg,#2A1E12,#1E150D,#3A2A15,#1E150D);background-size:300% 300%;animation:auroraMove 14s ease infinite;color:#F3E8D2;padding:22px 26px;border-radius:0 0 14px 14px;margin-bottom:18px;box-shadow:var(--shadow);}
header.top::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 85% -10%,rgba(184,132,46,.35),transparent 55%);pointer-events:none;}
.shimmer-text{background:linear-gradient(100deg,#F3E8D2 30%,#F3D98A 45%,#F3E8D2 60%);background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmer 4.5s linear infinite;}
@keyframes shimmer{to{background-position:-220% center;}}
header.top .row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
header.top .brand{display:flex;align-items:center;gap:14px;}
.emblem{width:46px;height:46px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#E9C77A,#B8842E 60%,#8C6423);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:20px;color:#2A1E12;flex-shrink:0;box-shadow:inset 0 0 0 2px rgba(255,255,255,.25);}
header.top h1{margin:0;font-size:22px;font-weight:600;letter-spacing:.2px;}
header.top .sub{margin:2px 0 0;font-size:12.5px;color:#CBB88E;}
.sync-pill{font-size:11.5px;padding:5px 11px;border-radius:20px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);color:#E9DCC0;display:flex;align-items:center;gap:6px;}
.sync-dot{width:7px;height:7px;border-radius:50%;background:#6FBF7A;}
.sync-dot.off{background:#C98F5B;}
/* TABS */
.tabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:2px solid var(--line);flex-wrap:wrap;}
.tab-btn{font-family:'Fraunces',serif;font-size:14.5px;font-weight:600;color:var(--ink-soft);background:var(--paper-alt);border:1px solid var(--line);border-bottom:none;padding:10px 20px;border-radius:10px 10px 0 0;cursor:pointer;position:relative;top:2px;transition:color .2s, transform .15s;}
.tab-btn:hover{color:var(--gold-deep);transform:translateY(-2px);}
.tab-btn.active{color:var(--ink);background:var(--paper);border-color:var(--gold);box-shadow:0 -2px 0 var(--gold) inset;}
.tab-panel{display:none;}
.tab-panel.active{display:block;animation:fadeSlideIn .35s cubic-bezier(.2,.8,.3,1);}
@keyframes fadeSlideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
.card{animation:cardIn .4s cubic-bezier(.2,.8,.3,1) backwards;}
.card:nth-of-type(1){animation-delay:.02s;}
.card:nth-of-type(2){animation-delay:.07s;}
.card:nth-of-type(3){animation-delay:.12s;}
.card:nth-of-type(4){animation-delay:.17s;}
@keyframes cardIn{from{opacity:0;transform:translateY(14px) scale(.99);}to{opacity:1;transform:none;}}
.card{transition:box-shadow .25s, transform .25s;}
.card:hover{box-shadow:0 6px 18px rgba(36,26,18,.12), 0 1px 1px rgba(36,26,18,.08);}
/* CARDS */
.card{background:var(--paper-alt);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin-bottom:18px;box-shadow:var(--shadow);}
.card h2{margin:0 0 4px;font-size:17px;}
.card .hint{color:var(--ink-soft);font-size:12.5px;margin:0 0 14px;}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
@media(max-width:900px){.grid-3,.grid-4{grid-template-columns:1fr 1fr;}}
@media(max-width:560px){.grid-3,.grid-4{grid-template-columns:1fr;}}
label.field{display:block;font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;color:var(--ink-soft);margin-bottom:5px;}
input[type=text],input[type=date],input[type=number],select,textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font-family:inherit;font-size:13.5px;}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(184,132,46,.15);}
input.invalid{border-color:var(--red);box-shadow:0 0 0 3px rgba(163,51,39,.15);animation:shake .35s;}
@keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-4px);}75%{transform:translateX(4px);}}
.btn{font-family:'Fraunces',serif;font-weight:600;font-size:13.5px;padding:10px 18px;border-radius:8px;border:1px solid var(--gold-deep);background:linear-gradient(180deg,var(--gold),var(--gold-deep));color:#2A1E12;cursor:pointer;box-shadow:var(--shadow);transition:transform .15s, box-shadow .15s, filter .15s;}
.btn:hover{filter:brightness(1.06);transform:translateY(-1px);box-shadow:0 4px 12px rgba(140,100,35,.3);}
.btn:active{transform:translateY(0) scale(.98);}
.btn.secondary{background:var(--paper);color:var(--ink);border-color:var(--line);}
.btn.ghost{background:transparent;color:var(--gold-deep);border-color:transparent;box-shadow:none;padding:6px 10px;}
.btn.small{padding:6px 12px;font-size:12.5px;}
.chip-row{display:flex;flex-wrap:wrap;gap:8px;}
.chip{padding:8px 14px;border-radius:20px;border:1px solid var(--line);background:#fff;font-size:13px;font-weight:600;cursor:pointer;color:var(--ink-soft);transition:all .18s;}
.chip:hover{border-color:var(--gold);color:var(--gold-deep);transform:translateY(-1px);}
.chip.active{background:var(--ink);color:#F3E8D2;border-color:var(--ink);transform:translateY(-1px);box-shadow:0 3px 10px rgba(36,26,18,.25);}
.seg{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;}
.seg button{flex:1;padding:7px 6px;font-size:12px;font-weight:700;border:none;background:#fff;color:var(--ink-soft);cursor:pointer;border-right:1px solid var(--line);transition:background .15s,color .15s,transform .1s;}
.seg button:last-child{border-right:none;}
.seg button:hover{background:#F6EFE0;}
.seg button:active{transform:scale(.95);}
.seg button.on.A{background:var(--green-bg);color:var(--green);animation:popIn .2s;}
.seg button.on.NA{background:var(--amber-bg);color:var(--amber);animation:popIn .2s;}
.seg button.on.NL{background:var(--red-bg);color:var(--red);animation:popIn .2s;}
@keyframes popIn{from{transform:scale(.85);}to{transform:scale(1);}}
table.ledger{width:100%;border-collapse:collapse;font-size:13px;}
table.ledger th{background:var(--ink);color:#F3E8D2;font-family:'Fraunces',serif;font-weight:600;font-size:12px;padding:8px 9px;text-align:left;position:sticky;top:0;}
table.ledger td{padding:7px 9px;border-bottom:1px solid var(--line-soft);}
table.ledger tr.cat-row td{background:var(--gold-bg);font-weight:700;color:var(--gold-deep);font-family:'Fraunces',serif;}
table.ledger tr td{transition:background .15s;}
table.ledger tr:hover td{background:#FCF9F0;}
.badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:11.5px;font-weight:700;border:1px solid transparent;transition:transform .15s;}
.badge:hover{transform:scale(1.06);}
.badge.A{background:var(--green-bg);color:var(--green);border-color:var(--green-line);}
.badge.NA{background:var(--amber-bg);color:var(--amber);border-color:var(--amber-line);}
.badge.NL{background:var(--red-bg);color:var(--red);border-color:var(--red-line);}
.kpi{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:14px 16px;transition:transform .2s, box-shadow .2s;animation:kpiIn .45s cubic-bezier(.2,.8,.3,1) backwards;}
.kpi:hover{transform:translateY(-3px);box-shadow:0 8px 18px rgba(36,26,18,.12);}
@keyframes kpiIn{from{opacity:0;transform:translateY(10px) scale(.96);}to{opacity:1;transform:none;}}
.kpi .num{font-family:'Fraunces',serif;font-size:26px;font-weight:700;}
.kpi .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--ink-soft);font-weight:600;}
.kpi.green{border-color:var(--green-line);background:var(--green-bg);}
.kpi.green .num{color:var(--green);}
.kpi.amber{border-color:var(--amber-line);background:var(--amber-bg);}
.kpi.amber .num{color:var(--amber);}
.kpi.red{border-color:var(--red-line);background:var(--red-bg);}
.kpi.red .num{color:var(--red);}
.kpi.gold{border-color:var(--line);background:var(--gold-bg);}
.kpi.gold .num{color:var(--gold-deep);}
.link-open{font-size:11px;color:var(--gold-deep);text-decoration:none;font-weight:700;white-space:nowrap;}
.link-open:hover{text-decoration:underline;}
.edit-link-btn{border:1px solid var(--line);background:#fff;color:var(--ink-soft);border-radius:5px;width:20px;height:20px;line-height:1;font-size:11px;cursor:pointer;padding:0;transition:all .15s;}
.edit-link-btn:hover{border-color:var(--gold);color:var(--gold-deep);transform:scale(1.1);}
.edit-link-btn.add{width:auto;padding:3px 9px;font-size:10.5px;font-weight:700;border-color:var(--red-line);color:var(--red);background:var(--red-bg);}
.edit-link-btn.add:hover{background:var(--red);color:#fff;transform:none;}
.link-missing{font-size:11px;font-weight:700;color:var(--red);}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(16px) scale(.96);background:var(--ink);color:#F3E8D2;padding:11px 22px;border-radius:30px;font-size:13.5px;font-weight:600;box-shadow:var(--shadow);z-index:999;opacity:0;transition:opacity .3s cubic-bezier(.2,.8,.3,1), transform .3s cubic-bezier(.2,.8,.3,1);}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0) scale(1);}
.pill-row{display:flex;flex-wrap:wrap;gap:6px;}
.small-muted{color:var(--ink-soft);font-size:12px;}
.divider{height:1px;background:var(--line-soft);margin:16px 0;}
.acc-head{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--gold-bg);border-radius:8px;cursor:pointer;font-family:'Fraunces',serif;font-weight:600;color:var(--gold-deep);margin-bottom:6px;}
.tag{font-size:10.5px;padding:2px 8px;border-radius:10px;background:var(--ink);color:#F3E8D2;font-weight:700;}
.scroll-x{overflow-x:auto;}
.two-col{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;}
@media(max-width:900px){.two-col{grid-template-columns:1fr;}}
textarea{min-height:80px;resize:vertical;}
.loader-ring{width:38px;height:38px;border:4px solid var(--line);border-top-color:var(--gold);border-radius:50%;margin:0 auto;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.remark-input{font-size:12px;padding:5px 7px;}
</style>
</head>
<body>
<div class="app">

<header class="top">
  <div class="row">
    <div class="brand">
      <div>
        <h1 class="shimmer-text">Trend-Mark</h1>
      </div>
    </div>
    <div id="syncPill" class="sync-pill"><span class="sync-dot off"></span> Local device only</div>
  </div>
</header>

<div class="tabs">
  <button class="tab-btn active" data-tab="entry">Daily Entry</button>
  <button class="tab-btn" data-tab="benchmark">Benchmark Report</button>
  <button class="tab-btn" data-tab="availability">Availability Report</button>
  <button class="tab-btn" data-tab="master">Master Data</button>
</div>

<!-- ============ ENTRY TAB ============ -->
<div class="tab-panel active" id="panel-entry">
  <div class="card">
    <h2>Check-in Details</h2>
    <p class="hint">Date, pincode aur platform select karke neeche price + availability bharo. Har SKU ke saamne "Open ↗" link se seedha us platform ka product page khul jaayega.</p>
    <div class="grid-3">
      <div>
        <label class="field">Date</label>
        <input type="date" id="entryDate">
      </div>
      <div>
        <label class="field">Pincode</label>
        <input type="text" id="entryPincode" list="pincodeList" placeholder="Type pincode or area...">
        <datalist id="pincodeList"></datalist>
      </div>
      <div>
        <label class="field">Entered By</label>
        <input type="text" id="entryBy" placeholder="Your name">
      </div>
    </div>
    <div class="divider"></div>
    <label class="field">Platform</label>
    <div class="chip-row" id="platformChips"></div>
  </div>

  <div class="card" id="benchmarkEntryCard" style="display:none;">
    <h2>5 KG Chakki Atta — Price Benchmark</h2>
    <p class="hint">Ganesh vs competitor selling price (₹) is platform par, is pincode ke liye.</p>
    <div class="grid-4" id="benchmarkInputs"></div>
  </div>

  <div class="card" id="availabilityEntryCard" style="display:none;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
      <div>
        <h2 style="margin-bottom:0;">KVI SKU Availability</h2>
        <p class="hint" style="margin-bottom:0;">Har SKU ka status maaro — A (Available) / NA (Listed, Not Available) / NL (Not Listed).</p>
      </div>
      <button class="btn secondary small" id="markAllA">Mark all Available</button>
    </div>
    <div id="availabilityList" style="margin-top:12px;"></div>
  </div>

  <div class="card" id="saveCard" style="display:none;">
    <button class="btn" id="saveEntryBtn">💾 Save Check-in</button>
    <span class="small-muted" id="saveHint" style="margin-left:12px;"></span>
  </div>

  <div class="card">
    <h2>Recent Check-ins</h2>
    <div class="scroll-x"><table class="ledger" id="recentTable"><thead><tr><th>Date</th><th>Pincode</th><th>Platform</th><th>Benchmark rows</th><th>Availability rows</th><th>By</th></tr></thead><tbody></tbody></table></div>
  </div>
</div>

<!-- ============ BENCHMARK REPORT TAB ============ -->
<div class="tab-panel" id="panel-benchmark">
  <div class="card">
    <h2>Filters</h2>
    <div class="grid-4">
      <div><label class="field">From Date</label><input type="date" id="bFrom"></div>
      <div><label class="field">To Date</label><input type="date" id="bTo"></div>
      <div><label class="field">Pincode</label><select id="bPincode"><option value="ALL">All Pincodes</option></select></div>
      <div><label class="field">Platform</label><select id="bPlatform"><option value="ALL">All Platforms</option></select></div>
    </div>
    <div style="margin-top:14px;"><button class="btn" id="bRun">Generate Report</button> <button class="btn secondary" id="bExport">⬇ Export Excel</button></div>
  </div>
  <div id="benchmarkReportOut"></div>
</div>

<!-- ============ AVAILABILITY REPORT TAB ============ -->
<div class="tab-panel" id="panel-availability">
  <div class="card">
    <h2>Filters</h2>
    <div class="grid-4">
      <div><label class="field">As-of Date</label><select id="aDate"></select></div>
      <div><label class="field">Pincode</label><select id="aPincode"><option value="ALL">All Pincodes</option></select></div>
      <div><label class="field">Platform</label><select id="aPlatform"><option value="ALL">All Platforms</option></select></div>
      <div><label class="field">Category</label><select id="aCategory"><option value="ALL">All Categories</option></select></div>
    </div>
    <div style="margin-top:14px;"><button class="btn" id="aRun">Generate Report</button> <button class="btn secondary" id="aExport">⬇ Export Excel</button></div>
  </div>
  <div id="availabilityReportOut"></div>
</div>

<!-- ============ MASTER DATA TAB ============ -->
<div class="tab-panel" id="panel-master">

  <div class="card">
    <h2>Import / Update Data</h2>
    <p class="hint">Apni latest "Quick Com Link", "5kg Benchmark" ya "KVI Availability" file yahan upload karke master data / history update karo — app rebuild karne ki zaroorat nahi. "Quick Com Link" upload karne se har product ke links ek-saath bulk mein update ho jaate hain. Ek-do link hi fix karne hain to neeche "SKU Master" table mein har link ke saamne ✎ se manually bhi update kar sakte ho — link sirf us product+platform ke liye save hota hai, sabhi pincode automatically wahi link use karenge.</p>
    <div class="grid-3">
      <div>
        <label class="field">Quick Com Link (SKU + URL master)</label>
        <input type="file" id="importLinks" accept=".xlsx">
      </div>
      <div>
        <label class="field">5KG Benchmark history (.xlsx)</label>
        <input type="file" id="importBenchmark" accept=".xlsx">
      </div>
      <div>
        <label class="field">KVI Availability history (.xlsx)</label>
        <input type="file" id="importAvailability" accept=".xlsx">
      </div>
    </div>
    <p class="small-muted" id="importStatus" style="margin-top:10px;"></p>
  </div>

  <div class="card">
    <h2>Pincode Master <span class="tag" id="pinCount"></span></h2>
    <div class="two-col">
      <div>
        <div class="scroll-x" style="max-height:340px;overflow-y:auto;">
          <table class="ledger" id="pincodeTable"><thead><tr><th>Pincode</th><th>Area</th><th>Region</th><th></th></tr></thead><tbody></tbody></table>
        </div>
      </div>
      <div>
        <label class="field">Bulk add (one per line: pincode,area,region)</label>
        <textarea id="bulkPincode" placeholder="700019,Ballygunge,Kolkata"></textarea>
        <button class="btn small" id="addBulkPincode" style="margin-top:8px;">Add</button>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>SKU Master <span class="tag" id="skuCount"></span></h2>
    <p class="hint">✓ = Track for 5KG Benchmark pricing (sirf 5 KG Chakki Atta default hai; aur SKU bhi tick kar sakte ho).</p>
    <div class="scroll-x" style="max-height:420px;overflow-y:auto;">
      <table class="ledger" id="skuTable"><thead><tr><th>#</th><th>Category</th><th>Item</th><th>Benchmark?</th><th>Links</th></tr></thead><tbody></tbody></table>
    </div>
  </div>

  <div class="card">
    <h2>Settings &amp; Backup</h2>
    <div class="grid-3">
      <div>
        <label class="field">Google Apps Script Web App URL (optional cloud sync)</label>
        <input type="text" id="apiUrlInput" placeholder="https://script.google.com/macros/s/.../exec">
        <button class="btn small secondary" id="saveApiUrl" style="margin-top:8px;">Save &amp; Connect</button>
      </div>
      <div>
        <label class="field">Backup all data (JSON)</label>
        <button class="btn small" id="exportBackup">⬇ Download backup</button>
      </div>
      <div>
        <label class="field">Restore from backup (JSON)</label>
        <input type="file" id="restoreBackup" accept=".json">
      </div>
    </div>
  </div>

</div>

