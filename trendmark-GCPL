document.getElementById('importLinks').addEventListener('change', async (e)=>{
  const file = e.target.files[0]; if(!file) return;
  setImportStatus('Reading Quick Com Link file...');
  const wb = new ExcelJS.Workbook();
  await wb.xlsx.load(await file.arrayBuffer());
  const ws = wb.worksheets[0];
  const platformCols = { Blinkit:5, Zepto:6, Instamart:7, BigBasket:8, JioMart:9, Jiffy:10, Flipkart:11 }; // 1-indexed columns E..K
  let updated = 0, added = 0;
  ws.eachRow((row, idx)=>{
    const sl = row.getCell(1).value;
    if(typeof sl !== 'number') return;
    const category = String(row.getCell(2).value||'').trim();
    const item = String(row.getCell(3).value||'').trim();
    const cls = String(row.getCell(4).value||'KVI').trim();
    const links = {};
    Object.entries(platformCols).forEach(([p,col])=>{
      const cell = row.getCell(col).value;
      links[p] = cell ? (cell.text || cell.hyperlink || cell) : "Not Listed";
      if(typeof links[p] === 'object') links[p] = links[p].text || JSON.stringify(links[p]);
    });
    let sku = DB.skus.find(s=>s.id===sl);
    if(sku){ sku.category=category; sku.item=item; sku.cls=cls; sku.links=links; updated++; }
    else { DB.skus.push({id:sl, category, item, cls, benchmark: item.toUpperCase()==='CHAKKI ATTA - 5 KG', links}); added++; }
  });
  persist('skus');
  setImportStatus(`Link master updated: ${updated} SKUs updated, ${added} new SKUs added.`);
  renderMaster();
});

document.getElementById('importBenchmark').addEventListener('change', async (e)=>{
  const file = e.target.files[0]; if(!file) return;
  setImportStatus('Reading Benchmark history file...');
  const wb = new ExcelJS.Workbook();
  await wb.xlsx.load(await file.arrayBuffer());
  const ws = wb.getWorksheet('Benchmark') || wb.worksheets[0];
  const platMap = {'Bigbasket':'BigBasket','Blinkit':'Blinkit','Zepto Now':'Zepto','Jiffy':'Jiffy','Flipkart':'Flipkart','Instamart':'Instamart','Jio B2C':'JioMart'};
  const platCols = ['Bigbasket','Blinkit','Zepto Now','Jiffy','Flipkart','Instamart','Jio B2C'];
  let count = 0;
  let i = 1;
  const rows = ws.rowCount;
  while(i <= rows){
    const row = ws.getRow(i);
    if(row.getCell(1).value === 'Category' && row.getCell(2).value === 'TIME'){
      let j = i+1;
      while(j<=rows && ws.getRow(j).getCell(1).value === 'Atta'){
        const r = ws.getRow(j);
        const dateVal = r.getCell(3).value;
        const isDateLike = dateVal && typeof dateVal === 'object' && typeof dateVal.getFullYear === 'function';
        const date = isDateLike ? dateVal.toISOString().slice(0,10) : String(dateVal).slice(0,10);
        const timeVal = r.getCell(2).value;
        let timeStr = "10:10 AM";
        if(timeVal && typeof timeVal === 'object' && typeof timeVal.getHours === 'function'){
          let hh = timeVal.getUTCHours(), mm = timeVal.getUTCMinutes();
          const ampm = hh >= 12 ? 'PM' : 'AM';
          hh = hh % 12; if(hh===0) hh = 12;
          timeStr = `${hh}:${String(mm).padStart(2,'0')} ${ampm}`;
        }
        const article = String(r.getCell(4).value||'');
        let brand = null;
        if(article.includes('Ganesh')) brand='Ganesh'; else if(article.includes('Aashirvaad')) brand='Aashirvaad';
        else if(article.includes('Fortune')) brand='Fortune'; else if(article.includes('Emami')) brand='Emami';
        platCols.forEach((pc,ci)=>{
          const val = r.getCell(6+ci).value;
          const price = parseFloat(val);
          if(brand && !isNaN(price) && price>0){
            DB.benchmark = DB.benchmark.filter(x=>!(x.date===date && x.pincode==='GEN' && x.platform===platMap[pc] && x.brand===brand));
            DB.benchmark.push({id:uid(), date, pincode:'GEN', area:'General (Pre-Pincode Tracking)', platform:platMap[pc], brand, price, enteredBy:'Imported', ts:date, time:timeStr});
            count++;
          }
        });
        j++;
      }
      i = j;
    } else i++;
  }
  persist('benchmark');
  setImportStatus(`Benchmark history imported: ${count} price points.`);
});

