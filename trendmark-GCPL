  const wb = new ExcelJS.Workbook();
  await wb.xlsx.load(await file.arrayBuffer());
  const platMap = {'BLINKIT':'Blinkit','ZEPTO':'Zepto','SWIGGY':'Instamart','BIGBASKET':'BigBasket','RELIANCE (JIO MART)':'JioMart','SPENCERS (JIFFY)':'Jiffy','FLIPKART':'Flipkart'};
  const platKeys = Object.keys(platMap);
  let count = 0;
  wb.worksheets.forEach(ws=>{
    const sheetName = ws.name.trim();
    const m = sheetName.match(/(\d{2})\.(\d{2})\.(\d{4})/);
    if(!m) return;
    const date = `${m[3]}-${m[2]}-${m[1]}`;
    ws.eachRow((row, idx)=>{
      const sl = row.getCell(1).value;
      if(typeof sl !== 'number') return;
      const category = String(row.getCell(2).value||'').trim();
      const item = String(row.getCell(3).value||'').trim();
      platKeys.forEach((pk, ci)=>{
        const status = normStatus(row.getCell(5+ci).value);
        DB.availability = DB.availability.filter(x=>!(x.date===date && x.pincode==='GEN' && x.platform===platMap[pk] && x.item===item));
        DB.availability.push({id:uid(), date, pincode:'GEN', area:'General (Pre-Pincode Tracking)', platform:platMap[pk], skuId:null, item, category, status, remarks:'', enteredBy:'Imported', ts:date});
        count++;
      });
    });
  });
  persist('availability');
  setImportStatus(`Availability history imported: ${count} status points.`);
});

function setImportStatus(msg){ document.getElementById('importStatus').textContent = msg; }

/* ===================== INIT ===================== */
initEntryTab();
refreshSyncPill();

</script>
