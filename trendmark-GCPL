  wsT.getCell(1,1).font=HEADER_FONT; wsT.getCell(1,2).font=HEADER_FONT;
  wsT.getCell(1,1).fill=HEADER_FILL; wsT.getCell(1,2).fill=HEADER_FILL;
  dates.forEach((d,i)=>{ const c=wsT.getCell(1,i+3); c.value=fmtDate(d); c.font=HEADER_FONT; c.fill=HEADER_FILL; });
  let tr = 2;
  EXPORT_PLATFORM_ORDER.forEach(p=>{
    const platRow = wsT.getCell(tr,1); platRow.value = EXPORT_PLATFORM_LABEL[p]; platRow.font={bold:true};
    BRANDS.forEach(brand=>{
      const bc = wsT.getCell(tr,2); bc.value = FULL_NAME[brand];
      if(brand==='Ganesh') bc.font = GOLD_FONT;
      dates.forEach((d,ci)=>{
        const rows = data.filter(x=>x.date===d && x.brand===brand && x.platform===p);
        const v = rows.length ? avg(rows.map(x=>x.price)) : null;
        if(v!==null) wsT.getCell(tr, ci+3).value = Math.round(v*100)/100;
      });
      tr++;
    });
  });
  wsT.getColumn(1).width=14; wsT.getColumn(2).width=30;
  for(let i=0;i<dates.length;i++) wsT.getColumn(3+i).width=12;

  /* ---------- SHEET 3: Pincode-wise Detail ---------- */
  const wsP = wb.addWorksheet('Pincode Detail');
  let pr = 1;
  const byPincode = groupBy(data, x=>x.pincode);
  Object.keys(byPincode).sort().forEach(pin=>{
    const pinCell = wsP.getCell(pr,1); pinCell.value = pincodeLabel(pin); pinCell.font = {bold:true, size:13, color:{argb:'FF8C6423'}};
    pr++;
    const byDate = groupBy(byPincode[pin], x=>x.date);
    Object.keys(byDate).sort().forEach(date=>{
      const rows = byDate[date];
      const platformsPresent = EXPORT_PLATFORM_ORDER.filter(p=>rows.some(x=>x.platform===p));
