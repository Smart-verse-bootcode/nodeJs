/* ===================== IST TIME HELPERS ===================== */
function nowISTTime12(){
  return new Date().toLocaleTimeString('en-IN', {timeZone:'Asia/Kolkata', hour:'2-digit', minute:'2-digit', hour12:true});
}
function tsToISTTime12(ts){
  if(!ts) return '';
  const d = new Date(ts);
  if(isNaN(d)) return '';
  return d.toLocaleTimeString('en-IN', {timeZone:'Asia/Kolkata', hour:'2-digit', minute:'2-digit', hour12:true});
}
function nowISTDateISO(){
  // en-CA locale gives YYYY-MM-DD
  return new Date().toLocaleDateString('en-CA', {timeZone:'Asia/Kolkata'});
}

/* ===================== STORAGE ===================== */
const LS = {
  get(k, fallback){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : fallback; }catch(e){ return fallback; } },
  set(k, v){ localStorage.setItem(k, JSON.stringify(v)); }
};

function loadDB(){
  let skus = LS.get('mtr_skus', null);
  if(!skus){ skus = window.__SKU_SEED__; LS.set('mtr_skus', skus); }
  let pincodes = LS.get('mtr_pincodes', null);
  if(!pincodes){
    pincodes = window.__PIN_SEED__;
    pincodes.push({pincode:"GEN", area:"General (Pre-Pincode Tracking)", region:"Legacy"});
    LS.set('mtr_pincodes', pincodes);
  }
  let benchmark = LS.get('mtr_benchmark', null);
  if(!benchmark){
    benchmark = window.__BENCH_SEED__.map(r => ({
      id: uid(), date: r.date, pincode: "GEN", area: "General (Pre-Pincode Tracking)",
      platform: r.platform, brand: r.brand, price: r.price, enteredBy: "Imported", ts: r.date, time: "10:10 AM"
    }));
    LS.set('mtr_benchmark', benchmark);
  }
  let availability = LS.get('mtr_availability', null);
  if(!availability){
    availability = window.__AVAIL_SEED__.map(r => ({
      id: uid(), date: r.date, pincode: "GEN", area: "General (Pre-Pincode Tracking)",
      platform: r.platform, skuId: null, item: r.item, category: r.category,
      status: normStatus(r.status), remarks: r.remarks || "", enteredBy: "Imported", ts: r.date
    }));
    LS.set('mtr_availability', availability);
  }
  let settings = LS.get('mtr_settings', {apiUrl:"", enteredBy:""});
  return {skus, pincodes, benchmark, availability, settings};
}

function normStatus(s){
  if(!s) return "NL";
  s = String(s).trim().toUpperCase();
  if(s === "A") return "A";
  if(s === "NA") return "NA";
  return "NL"; // Not Listed / anything else
}

function uid(){ return Math.random().toString(36).slice(2,10) + Date.now().toString(36).slice(-4); }

