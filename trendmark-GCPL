  const note = platform === 'Instamart' ? ' title="Instamart web link kabhi-kabhi \'Something went wrong\' error deta hai (unke app-session na hone se) — aisa ho to Instamart app ya site par jaake naam se search karo."' : '';
  return `<a class="link-open" href="${url}" target="_blank"${note}>${label}</a>`;
}
// Open link + a pencil icon to fix/update that SKU's platform URL in one go (updates for ALL pincodes, since links are per-SKU+platform, not per-pincode)
function linkWithEdit(skuId, platform, shortLabel){
  const sku = DB.skus.find(s=>s.id===skuId);
  const url = sku && sku.links ? sku.links[platform] : null;
  const label = shortLabel ? platform.slice(0,3) : 'Open ↗';
  if(isUrl(url)){
    return `${linkTag(url, platform, label)} <button class="edit-link-btn" title="Link update karo (sabhi pincode ke liye)" onclick="editLink(${skuId},'${platform}')">✎</button>`;
  }
  // No real product link saved — whatever placeholder text was imported (A / NA / Not Listed / blank)
  // is stale reference data, not an actual availability status, so never show it as if it were one.
  const missLabel = shortLabel ? `${platform.slice(0,3)}: ⚠ missing` : '⚠ Link missing';
  return `<span class="link-missing">${missLabel}</span> <button class="edit-link-btn add" title="Is product ka link add karo (sabhi pincode ke liye)" onclick="editLink(${skuId},'${platform}')">+ Add link</button>`;
}
function editLink(skuId, platform){
  const sku = DB.skus.find(s=>s.id===skuId);
  if(!sku) return;
  if(!sku.links) sku.links = {};
  const existing = sku.links[platform] || '';
  const current = isUrl(existing) ? existing : ''; // don't prefill stale "A"/"NA"/"Not Listed" placeholders as if they were a link
  const next = window.prompt(`${sku.item} — ${platform} ka product link daalo (sabhi pincode ke liye apply hoga):`, current);
  if(next === null) return; // cancelled
  const trimmed = next.trim();
  if(trimmed && !isUrl(trimmed)){
    toast('⚠ Ye ek valid link nahi lag raha (http:// ya https:// se shuru hona chahiye) — dobara try karo');
    return;
  }
  sku.links[platform] = trimmed; // empty string = still shows as "Link missing" until a real URL is added
  persist('skus');
  toast(trimmed ? `✓ ${platform} link update ho gaya — ${sku.item}` : `Link clear kar diya — ${sku.item}`);
  // refresh whichever view is currently showing this
  if(document.getElementById('panel-entry').classList.contains('active')) renderEntryBody();
  if(document.getElementById('panel-master').classList.contains('active')) renderMaster();
}

