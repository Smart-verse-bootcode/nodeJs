function renderAvailabilityReport(){
  const data = getAvailabilityFiltered();
  const out = document.getElementById('availabilityReportOut');
  if(data.length===0){ out.innerHTML = '<div class="card"><p class="small-muted">Is filter ke liye koi data nahi mila.</p></div>'; return; }

  const platformsPresent = [...new Set(data.map(r=>r.platform))].sort((a,b)=>PLATFORMS.indexOf(a)-PLATFORMS.indexOf(b));

  // KPI per platform
  let kpiHtml = platformsPresent.map((p,i)=>{
    const rows = data.filter(r=>r.platform===p);
    const tot = rows.length, avail = rows.filter(r=>r.status==='A').length, na = rows.filter(r=>r.status==='NA').length, nl = rows.filter(r=>r.status==='NL').length;
    const pct = tot ? Math.round(avail/tot*100) : 0;
    return `<div class="kpi ${pct>=70?'green':pct>=40?'amber':'red'}" style="animation-delay:${i*0.05}s;"><div class="num mono" data-target="${pct}" data-suffix="%" data-decimals="0">0%</div><div class="lbl">${p} · ${avail}/${tot} Available</div></div>`;
  }).join('');
  let html = `<div class="card"><h2>Summary by Platform</h2><div class="grid-4">${kpiHtml}</div></div>`;

  // Grid
  const skuIds = [...new Set(data.map(r=>r.skuId!==null?r.skuId:r.item))];
  const cats = [...new Set(data.map(r=>r.category))];
  html += `<div class="card"><h2>Availability Grid</h2><div class="scroll-x"><table class="ledger"><thead><tr><th>Item</th>${platformsPresent.map(p=>`<th>${p}</th>`).join('')}</tr></thead><tbody>`;
  cats.forEach(cat=>{
    html += `<tr class="cat-row"><td colspan="${platformsPresent.length+1}">${cat}</td></tr>`;
    const items = [...new Set(data.filter(r=>r.category===cat).map(r=>r.item))];
    items.forEach(item=>{
      html += `<tr><td>${item}</td>` + platformsPresent.map(p=>{
        const rec = data.find(r=>r.item===item && r.platform===p);
        if(!rec) return `<td class="small-muted">—</td>`;
        const title = rec.remarks ? ` title="${rec.remarks.replace(/"/g,'')}"` : '';
        return `<td><span class="badge ${rec.status}"${title}>${rec.status}${rec.remarks?' •':''}</span></td>`;
      }).join('') + `</tr>`;
    });
  });
  html += `</tbody></table></div></div>`;
  out.innerHTML = html;
  animateKPIs(out);
}

