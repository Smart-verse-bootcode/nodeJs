function renderBenchmarkReport(){
  const data = getBenchmarkFiltered();
  const out = document.getElementById('benchmarkReportOut');
  if(data.length===0){ out.innerHTML = '<div class="card"><p class="small-muted">Is filter ke liye koi data nahi mila.</p></div>'; return; }

  // KPIs
  const ganeshRows = data.filter(r=>r.brand==='Ganesh');
  const ganeshAvg = avg(ganeshRows.map(r=>r.price));
  const compRows = data.filter(r=>r.brand!=='Ganesh');
  const compAvg = avg(compRows.map(r=>r.price));
  const gap = ganeshAvg - compAvg;
  const gapPct = compAvg ? (gap/compAvg*100) : 0;

  // rank calc
  const groups = groupBy(data, r=>r.date+'|'+r.pincode+'|'+r.platform);
  let rankCounts = {1:0,2:0,3:0,4:0};
  Object.values(groups).forEach(g=>{
    const byBrand = {}; g.forEach(r=>byBrand[r.brand]=r.price);
    const sorted = Object.entries(byBrand).sort((a,b)=>a[1]-b[1]);
    const idx = sorted.findIndex(([b])=>b==='Ganesh');
    if(idx>=0) rankCounts[idx+1] = (rankCounts[idx+1]||0)+1;
  });
  const totalGroups = Object.values(rankCounts).reduce((a,b)=>a+b,0) || 1;
  const cheapestPct = Math.round((rankCounts[1]/totalGroups)*100);

  let html = `<div class="card"><h2>Summary</h2>
  <div class="grid-4">
    <div class="kpi gold" style="animation-delay:.02s;"><div class="num mono" data-target="${ganeshAvg}" data-prefix="₹" data-decimals="2">₹0.00</div><div class="lbl">Ganesh Avg Price</div></div>
    <div class="kpi ${gap<=0?'green':'red'}" style="animation-delay:.08s;"><div class="num mono" data-target="${gap}" data-prefix="${gap>=0?'+₹':'₹'}" data-decimals="2">₹0.00</div><div class="lbl">Gap vs Competitor Avg (${gapPct.toFixed(1)}%)</div></div>
    <div class="kpi ${cheapestPct>=50?'green':'amber'}" style="animation-delay:.14s;"><div class="num mono" data-target="${cheapestPct}" data-suffix="%" data-decimals="0">0%</div><div class="lbl">Times Ganesh Cheapest</div></div>
    <div class="kpi gold" style="animation-delay:.2s;"><div class="num mono" data-target="${data.length}" data-decimals="0">0</div><div class="lbl">Price Points Captured</div></div>
  </div></div>`;

  html += `<div class="card"><h2>Price Trend — Ganesh vs Competitors</h2>${svgTrendChart(data)}</div>`;

  // Detailed matrix grouped by pincode -> date
  const byPincode = groupBy(data, r=>r.pincode);
  html += `<div class="card"><h2>Detailed Matrix</h2><div class="scroll-x">`;
  Object.keys(byPincode).sort().forEach(pin=>{
    html += `<h3 style="margin:14px 0 6px;">${pincodeLabel(pin)}</h3>`;
    const byDate = groupBy(byPincode[pin], r=>r.date);
    Object.keys(byDate).sort().forEach(date=>{
      const rows = byDate[date];
      const platformsPresent = [...new Set(rows.map(r=>r.platform))];
      html += `<table class="ledger" style="margin-bottom:14px;"><thead><tr><th>${fmtDate(date)}</th>${platformsPresent.map(p=>`<th>${p}</th>`).join('')}</tr></thead><tbody>`;
      BRANDS.forEach(brand=>{
        const cells = platformsPresent.map(p=>{
          const rec = rows.find(r=>r.brand===brand && r.platform===p);
          return rec ? rec.price : null;
        });
        const valid = cells.filter(c=>c!==null);
        const min = Math.min(...valid), max = Math.max(...valid);
        html += `<tr><td style="font-weight:700;${brand==='Ganesh'?'color:var(--gold-deep);':''}">${FULL_NAME[brand]}</td>` +
          cells.map(c=>{
            if(c===null) return `<td class="mono small-muted">—</td>`;
            let bg = '';
            if(valid.length>1){ if(c===min) bg='background:var(--green-bg);color:var(--green);font-weight:700;'; else if(c===max) bg='background:var(--red-bg);color:var(--red);'; }
            return `<td class="mono" style="${bg}">₹${c.toFixed(2)}</td>`;
          }).join('') + `</tr>`;
      });
      html += `</tbody></table>`;
    });
  });
  html += `</div></div>`;
  out.innerHTML = html;
  animateKPIs(out);
}

const RAF = window.requestAnimationFrame ? window.requestAnimationFrame.bind(window) : (fn)=>setTimeout(()=>fn(Date.now()), 16);
const NOW = (window.performance && window.performance.now) ? ()=>window.performance.now() : ()=>Date.now();
function animateKPIs(container){
  container.querySelectorAll('.num[data-target]').forEach(el=>{
    const target = parseFloat(el.dataset.target);
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const decimals = el.dataset.decimals !== undefined ? parseInt(el.dataset.decimals) : 2;
    const dur = 650, start = NOW();
    function tick(now){
      const t = Math.min(1, (now-start)/dur);
      const eased = 1 - Math.pow(1-t, 3);
      const val = target * eased;
      el.textContent = prefix + val.toFixed(decimals) + suffix;
      if(t < 1) RAF(tick);
      else el.textContent = prefix + target.toFixed(decimals) + suffix;
    }
    RAF(tick);
  });
}

function avg(arr){ arr = arr.filter(v=>!isNaN(v)); return arr.length ? arr.reduce((a,b)=>a+b,0)/arr.length : 0; }
function groupBy(arr, fn){ const o={}; arr.forEach(x=>{ const k=fn(x); (o[k]=o[k]||[]).push(x); }); return o; }

function svgTrendChart(data){
  const dates = [...new Set(data.map(r=>r.date))].sort();
  if(dates.length < 2) return '<p class="small-muted">Trend dekhne ke liye kam se kam 2 alag dates ka data chahiye.</p>';
  const W = 900, H = 260, padL = 50, padR = 20, padT = 20, padB = 30;
  const colors = {Ganesh:'#B8842E', Aashirvaad:'#5B8DB8', Fortune:'#7A9E5E', Emami:'#B85B7A'};
  const series = {};
  BRANDS.forEach(b=>{
    series[b] = dates.map(d=>{
      const rows = data.filter(r=>r.date===d && r.brand===b);
      return rows.length ? avg(rows.map(r=>r.price)) : null;
    });
  });
  const allVals = Object.values(series).flat().filter(v=>v!==null);
  const minV = Math.min(...allVals) - 5, maxV = Math.max(...allVals) + 5;
  const x = i => padL + (i/(dates.length-1)) * (W-padL-padR);
  const y = v => H-padB - ((v-minV)/(maxV-minV)) * (H-padT-padB);

  let svg = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;font-family:'IBM Plex Mono',monospace;">`;
  // gridlines
  for(let g=0; g<=4; g++){
    const gy = padT + g*(H-padT-padB)/4;
    svg += `<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="#DECBA3" stroke-width="1"/>`;
  }
  BRANDS.forEach(b=>{
    const pts = series[b].map((v,i)=> v===null ? null : `${x(i)},${y(v)}`).filter(Boolean).join(' ');
    svg += `<polyline points="${pts}" fill="none" stroke="${colors[b]}" stroke-width="${b==='Ganesh'?3:2}" />`;
    series[b].forEach((v,i)=>{ if(v!==null) svg += `<circle cx="${x(i)}" cy="${y(v)}" r="${b==='Ganesh'?4:3}" fill="${colors[b]}"/>`; });
  });
  dates.forEach((d,i)=>{ if(i%Math.ceil(dates.length/8||1)===0) svg += `<text x="${x(i)}" y="${H-8}" font-size="10" fill="#6B5842" text-anchor="middle">${d.slice(5)}</text>`; });
  svg += `</svg><div class="pill-row" style="margin-top:8px;">` + BRANDS.map(b=>`<span class="chip" style="cursor:default;border-color:${colors[b]};color:${colors[b]};background:#fff;">● ${FULL_NAME[b]}</span>`).join('') + `</div>`;
  return svg;
}

